# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# JWT Authentication
JWT_SECRET=your-secret-key-change-this

# Database (SQLite path)
DB_PATH=./storage/database.sqlite

# Email (use Ethereal for testing: https://ethereal.email/)
